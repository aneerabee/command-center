# brix-mailops — قالب المتغيرات
# انسخه إلى .env واملأ القيم الحقيقية. لا تضع .env داخل git أبدًا (مُتجاهَل في .gitignore).
#
# التشغيل المحلي:
#   1) export كل متغير، أو
#   2) املأ .env ثم:  npm run phase0:env
#
# التشغيل السحابي (Claude Code on the web):
#   احفظ نفس المتغيرات كـ environment secrets في إعدادات البيئة — لا في git.
#
# القيم الدقيقة من لوحة Hostinger: hPanel ← Emails ← Connect Devices / Configuration

# --- IMAP (قراءة الوارد) ---
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=reservation@brixtravel.com
IMAP_PASS=

# --- SMTP (إرسال) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=reservation@brixtravel.com
SMTP_PASS=

# --- خيارات اختبار Phase 0 ---
# RUN_SEND_TEST=true   يرسل رسالة اختبار حقيقية إلى نفس الحساب
# RUN_APPEND_TEST=true يضيف رسالة اختبار إلى مجلد عبر IMAP APPEND
RUN_SEND_TEST=false
RUN_APPEND_TEST=false
